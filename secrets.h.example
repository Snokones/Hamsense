// secrets.h.example
//
// Copy this file to secrets.h and fill in your real values.
// secrets.h is listed in .gitignore -- it must NEVER be committed.
// (This .example file holds only placeholders and is safe to commit.)

#pragma once

#define WIFI_SSID     "YourWiFiName"
#define WIFI_PASSWORD "YourWiFiPassword"

// Fallback AP credentials: if the device can't join the WiFi network above
// after a few retries, it broadcasts its own network using these instead,
// so the page is still reachable with no home WiFi available.
#define FALLBACK_AP_SSID     "PotaSense"
#define FALLBACK_AP_PASSWORD "ChooseAStrongAPPassword"

// Web UI login (HTTP Basic Auth). Guards the live page, /history, and the
// WebSocket feed. Required -- the build fails if these are missing. Basic Auth
// over plain HTTP is base64, not encryption, so pick a passphrase you don't
// reuse elsewhere and treat it as "keep casual users out," not real secrecy.
#define WEB_USER "admin"
#define WEB_PASS "ChooseAStrongPassphrase"

// AccuWeather API key for the 5-day forecast panel (no-gps branch only).
// Free key: https://developer.accuweather.com/ -- register an app, copy the key.
// Required -- the build fails if it's missing.
//
// Read this before you assume it's secret: the forecast is fetched by the
// BROWSER, so the page has to be given this key. The firmware serves it from
// the auth-gated GET /config endpoint, which keeps it out of git but NOT out
// of reach of anyone who can log into the page. Treat it as "not committed,"
// not as "confidential," and rotate it if WEB_PASS ever leaks.
//
// The free tier is 50 calls/day for the whole key, shared across every browser
// that opens the page. The page caches aggressively to stay inside that (ZIP
// lookups cached permanently, forecast for 3 hours) -- if you find yourself
// hitting the quota, raise the cache TTL in web_pages.h rather than lowering it.
#define ACCUWEATHER_API_KEY "YourAccuWeatherApiKey"

// Optional: static IP instead of DHCP (uncomment USE_STATIC_IP to use)
// #define USE_STATIC_IP
// #ifdef USE_STATIC_IP
//   #define STATIC_IP   "192.168.1.50"
//   #define STATIC_GW   "192.168.1.1"
//   #define STATIC_MASK "255.255.255.0"
//   #define STATIC_DNS  "192.168.1.1"
// #endif
