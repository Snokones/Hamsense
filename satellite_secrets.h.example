// satellite_secrets.h.example
//
// Copy this file to satellite_secrets.h and fill in your real values.
// satellite_secrets.h is listed in .gitignore -- it must NEVER be committed.
// (This .example file holds only placeholders and is safe to commit.)

#pragma once

// Home WiFi SSID. The satellite never joins the network -- it only scans for
// this name to learn which channel the base station is on (ESP-NOW needs both
// ends on the same channel). No password is needed here.
#define WIFI_SSID "YourWiFiName"

// Base station's fallback AP name (must match FALLBACK_AP_SSID in the base's
// secrets.h). The satellite scans for this too, so it keeps delivering even
// when the base has dropped into PotaSense AP mode.
#define FALLBACK_AP_SSID "PotaSense"

// Base station's STATION-mode MAC address -- the ESP-NOW unicast target.
// Flash the base station FIRST; it prints this MAC on its Serial Monitor at
// boot. Copy those six hex bytes here (order as printed, colon-separated).
#define BASE_MAC { 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF }
